+// Detach takes the document out of its window, which stays open to show
+// another document, as an app that shows several documents in a window,
+// as tabs, does with those it hides. The document stays open without a
+// window until Attach gives it one, or CloseKeepingWindow closes it; its
+// window's title, File menu and dialogs then are no longer its own.
+// Safe from any goroutine.
+func (b *docBase) Detach() { onMain(b.detach) }
+
+func (b *docBase) detach() {
+	b.mu.Lock()
+	w, offs := b.window, b.offs
+	b.window, b.offs = nil, nil
+	b.mu.Unlock()
+	for _, off := range offs {
+		off()
+	}
+	if w != nil {
+		docRegistry.Lock()
+		if docRegistry.byWindow[w] == b {
+			delete(docRegistry.byWindow, w)
+		}
+		docRegistry.Unlock()
+	}
+	b.persistEdits()
+	refreshDocumentMenus()
+}

+//go:build !js
+
+package mygo
+
+import (
+	"slices"
+	"testing"
+)
+
+// Several documents in one window, as tabs: one attached, the others
+// detached, each closing without the window.
+func TestDocumentTabs(t *testing.T) {
+	var focused []*Document[string]
+	var host *Window
+	ds := testDocs(t, DocumentsOptions[string]{Autosave: AutosaveOff, Focus: func(d *Document[string]) {
+		focused = append(focused, d)
+		d.Attach(host)
+	}})
+	p1, p2 := writeTemp(t, "one.txt", "1"), writeTemp(t, "two.txt", "2")
+	d1, _ := ds.Open(p1)
+	d2, _ := ds.Open(p2)
+	w1, w2 := d1.Window(), d2.Window()
+	host = w1
+
+	// d2 moves into d1's window, which then is its own.
+	d2.Attach(w1)
+	if d1.Window() != nil || d2.Window() != w1 || ds.ForWindow(w1) != d2 || ds.ForWindow(w2) != nil {
+		t.Fatalf("after Attach: d1 in %p, d2 in %p, w1 shows %v", d1.Window(), d2.Window(), ds.ForWindow(w1))
+	}
+	w2.Destroy()
+	waitFor(t, "w2 to close", func() bool { return w2.IsDestroyed() })
+	if len(ds.Documents()) != 2 {
+		t.Fatalf("closing the emptied window closed documents: %d left", len(ds.Documents()))
+	}
+
+	// Opening the detached d1 again asks the app to show it.
+	if d, _ := ds.Open(p1); d != d1 || !slices.Contains(focused, d1) || d1.Window() != w1 || d2.Window() != nil {
+		t.Fatalf("Open of a detached document: focused %v, d1 in %p", focused, d1.Window())
+	}
+
+	// d1, edited, closes after saving, and its window stays.
+	d1.Set("one")
+	asked := answer("Save")
+	closed := make(chan bool, 1)
+	d1.CloseKeepingWindow(func(ok bool) { closed <- ok })
+	if !<-closed || len(asked.all()) != 1 || readString(t, p1) != "one" {
+		t.Fatalf("CloseKeepingWindow: asked %q, file %q", asked.all(), readString(t, p1))
+	}
+	if w1.IsDestroyed() || slices.Contains(ds.Documents(), d1) || ds.ForWindow(w1) != nil {
+		t.Fatalf("after CloseKeepingWindow: window destroyed %v, documents %d", w1.IsDestroyed(), len(ds.Documents()))
+	}
+
+	// Canceled, the document stays open.
+	d2.Attach(w1)
+	d2.Set("two")
+	answer("Cancel")
+	d2.CloseKeepingWindow(func(ok bool) { closed <- ok })
+	if <-closed || !slices.Contains(ds.Documents(), d2) || d2.Window() != w1 {
+		t.Fatal("a canceled CloseKeepingWindow closed the document")
+	}
+	d2.SetEdited(false)
+
+	// Closing the window closes the document it shows.
+	w1.Close()
+	waitFor(t, "d2 to close with w1", func() bool { return !slices.Contains(ds.Documents(), d2) })
+}
